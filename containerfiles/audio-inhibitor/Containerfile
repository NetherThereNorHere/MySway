# --- STAGE 1: Download and Build directly from Rust Registry ---
FROM fedora:latest AS builder

# Install core build dependencies
RUN dnf install -y cargo clang-devel libxkbcommon-devel pipewire-devel systemd-devel wayland-devel wayland-protocols-devel

# Natively fetch and build the binary directly from the official crate registry
RUN cargo install wayland-pipewire-idle-inhibit --root /tmp/install

# --- STAGE 2: Seamlessly Inject Into Your Image ---
FROM $BASE_IMAGE AS final

# Pluck the static executable from the installation directory
COPY --from=builder /tmp/install/bin/wayland-pipewire-idle-inhibit /usr/bin/wayland-pipewire-idle-inhibit
RUN chmod +x /usr/bin/wayland-pipewire-idle-inhibit
