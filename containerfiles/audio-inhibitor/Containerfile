# --- STAGE 1: Isolated Build Environment ---
FROM fedora:latest AS builder

# Install core build dependencies and native protocol schemas
RUN dnf install -y git cargo clang-devel libxkbcommon-devel pipewire-devel systemd-devel wayland-devel wayland-protocols-devel

# Clone the repository using the explicit folder layout
RUN git clone https://github.com/rafaelrc7/wayland-pipewire-idle-inhibit.git /tmp/build
WORKDIR /tmp/build

# Compile an optimized production release binary
RUN cargo build --release

# --- STAGE 2: Seamlessly Inject Into Your Image ---
FROM $BASE_IMAGE AS final

# Pluck ONLY the finished executable out of the builder layer
COPY --from=builder /tmp/build/target/release/wayland-pipewire-idle-inhibit /usr/bin/wayland-pipewire-idle-inhibit
RUN chmod +x /usr/bin/wayland-pipewire-idle-inhibit
