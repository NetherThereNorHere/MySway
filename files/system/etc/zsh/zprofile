# Only trigger on the first physical login on TTY1
if [[ -z "$DISPLAY" && -z "$WAYLAND_DISPLAY" && $(tty) == "/dev/tty1" ]]; then
    # exec replaces the shell process with sway
    # if you exit sway, you will be logged out
    exec sway
fi

# Fallback tmux logic for other TTYs or SSH
if [[ -z "$TMUX" && -z "$DISPLAY" && $- == *i* ]]; then
    tmux attach-session -t main || tmux new-session -s main
fi
